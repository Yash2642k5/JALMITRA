# Copy to .env before running:  cp .env.example .env
PORT=3000

# Signing secret for QR tokens (HMAC-SHA256). Change this.
HMAC_SECRET=jal-mitra-demo-secret-change-me

# ============================================================
# AWS
# ------------------------------------------------------------
# Every AWS integration below is OPTIONAL and turns itself on only when its
# fields are filled. With all of them blank the app runs fully offline on
# localhost, which is the stage fallback. Fill in what you have.
#
# On EC2 / App Runner, leave the key and secret BLANK — the SDK picks up the
# instance IAM role automatically, which is the better practice to demo.
# ============================================================

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Amazon SNS: ward broadcast + quota reply over real SMS ---------------
# The core channel. Set SNS_ENABLED=true once the account is out of the SMS
# sandbox, or while every demo phone number is a verified sandbox destination.
# Leave false to keep SMS simulated in the phone page.
SNS_ENABLED=false
SNS_SENDER_ID=JALMITRA
SNS_SMS_TYPE=Transactional
# Optional: also fan out every broadcast to a topic (ops/monitoring feed)
SNS_BROADCAST_TOPIC_ARN=

# --- Amazon DynamoDB: ward registers + durable audit ledger ---------------
# Leave the prefix blank to keep everything in memory.
# Create the tables with:  npm run aws:setup
DDB_TABLE_PREFIX=jalmitra
DDB_ENABLED=false

# --- Amazon S3: QR images and audit ledger exports ------------------------
# QR codes need a public URL to be attached as an SMS/WhatsApp media message.
S3_ENABLED=false
S3_BUCKET=
S3_PREFIX=jal-mitra
# Minutes a presigned QR link stays valid
S3_URL_TTL_MINUTES=120

# --- Amazon CloudWatch: litres dispensed, claims blocked ------------------
CLOUDWATCH_ENABLED=false
CLOUDWATCH_NAMESPACE=JalMitra

# --- AWS IoT Core: real flow-meter metering (ESP32) -----------------------
# When a tanker has a real flow sensor, the ESP32 publishes to an IoT topic
# and an IoT Rule forwards it to POST /api/meter/reading. With this enabled
# the dispense engine uses MEASURED litres instead of the simulated rate.
IOT_ENABLED=false
IOT_TOPIC=jalmitra/tanker/+/flow
# Shared secret the IoT Rule sends as x-meter-key, so only the rule can post
METER_INGEST_KEY=

# ============================================================
# Quota engine
# ------------------------------------------------------------
# 40 L/person matches the 40-50 L/head/day that tanker delivery is observed to
# work out to in practice. Drop to 20 only if you mean drinking + cooking alone.
# Tune per ward and per season.
LITRES_PER_PERSON=40
MAX_LITRES_PER_HOUSEHOLD=400
FAMILY_MISMATCH_THRESHOLD=1

# Delivery defaults (the coordinator can override these per delivery)
DEFAULT_TANKER_CAPACITY_LITRES=5000
DEFAULT_CLAIM_WINDOW_MINUTES=120

# Who operates the dispatch screen.
# Rural: "Gram Panchayat" or "BDO Office". City: "Zonal Control Room".
# Informal colonies: "RWA Committee".
COORDINATOR_LABEL=RWA Committee

# Resident-facing SMS language: en | hi | both
SMS_LANGUAGE=both

# Tokens
TOKEN_TTL_MINUTES=30

# Demo dispense speed (litres per second, accelerated for stage).
# Ignored for a tanker that is reporting real flow-meter readings.
DISPENSE_RATE_LPS=10

# Public base URL (tunnel, EC2 DNS or CloudFront) so QR media links resolve
PUBLIC_BASE_URL=

# Optional: Twilio WhatsApp Sandbox, as an alternative to SNS for WhatsApp.
# Not required — the webhook answers with TwiML regardless.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
